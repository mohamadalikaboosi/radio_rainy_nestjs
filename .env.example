NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- REQUIRED ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radio_rainy
REDIS_URL=redis://localhost:6379

# Encrypts EVERY secret stored in the database (Telegram session + API hash, Whisper/LLM keys) with AES-256-GCM.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (keep it safe: without it stored secrets cannot be decrypted)
TELEGRAM_SESSION_ENCRYPTION_KEY=

# OPTIONAL. Leave both empty: the first start creates admin / admin and forces a password change at the first login.
# Set both to seed a different first admin instead (username + scrypt hash; only used while the database has no admin yet).
ADMIN_EMAIL=
# generate: pnpm --silent --filter @radio_rainy/api hash-password 'your-password'   (format scrypt:<salt>:<hash>)
ADMIN_PASSWORD_HASH=
# at least 32 chars
JWT_SECRET=

# ---- OPTIONAL: everything below is normally configured from the admin panel (Settings / Channels pages) ----
# Telegram API id/hash (my.telegram.org): panel -> Settings. These env vars are only a fallback.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional bootstrap of an existing session string (imported once, stored encrypted). Normally: log in from the panel.
TELEGRAM_SESSION=

# Whisper-compatible endpoint (OpenAI /v1/audio/transcriptions). Panel -> Settings -> Whisper. Empty = AI lyrics sync off.
WHISPER_URL=
WHISPER_MODEL=whisper-1
WHISPER_API_KEY=
WHISPER_LANGUAGE=
# audio sent to Whisper is converted to this sample rate (mono FLAC)
WHISPER_SAMPLE_RATE=48000

# Audio cache in MinIO / S3 (panel -> Settings -> Audio storage). Empty = every play/transcription downloads from Telegram.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=radio-rainy-audio
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

RADIO_RECENT_TRACK_WINDOW=10
RADIO_PREBUFFER_SECONDS=2
# the next track is selected and downloaded this many seconds before the current one ends (see docs/PLAYBACK.md)
RADIO_PREFETCH_SECONDS=30
RADIO_PREFETCH_TIMEOUT_SECONDS=15
# Data-saver stream (?quality=low): ONE extra ffmpeg per station, only while someone listens it. Mono mp3, 16-96 kbps.
RADIO_LOW_QUALITY_ENABLED=true
RADIO_LOW_BITRATE_KBPS=48
RADIO_STREAM_BITRATE_KBPS=128

# Local audio cache: every track is downloaded from Telegram once and kept here (LRU). 0 MB disables it.
# AUDIO_CACHE_DIR=/tmp/radio_rainy/audio-cache
AUDIO_CACHE_MAX_MB=1024
AUDIO_CACHE_CONCURRENT_FILLS=2
# Prometheus metrics at GET /metrics with "Authorization: Bearer <token>" (min 16 chars). Unset = disabled.
# METRICS_TOKEN=
LYRICS_CACHE_TTL=86400
TELEGRAM_SYNC_INTERVAL_SECONDS=300
FFMPEG_PATH=ffmpeg
TMP_DIR=/tmp/radio_rainy
QUEUE_PREFIX=radio_rainy
