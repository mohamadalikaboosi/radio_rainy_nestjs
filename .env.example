NODE_ENV=development
PORT=3000

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNEL=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/radio_rainy
REDIS_URL=redis://localhost:6379

RADIO_RECENT_TRACK_WINDOW=10
RADIO_PREBUFFER_SECONDS=2

# Whisper-compatible (OpenAI style /v1/audio/transcriptions) endpoint
WHISPER_PROVIDER=openai-compatible
WHISPER_MODEL=whisper-1
WHISPER_URL=
WHISPER_API_KEY=

LYRICS_CACHE_TTL=86400

ADMIN_EMAIL=
# format: scrypt$<saltHex>$<hashHex> (see `pnpm --filter @radio_rainy/api hash-password`)
ADMIN_PASSWORD_HASH=
JWT_SECRET=
