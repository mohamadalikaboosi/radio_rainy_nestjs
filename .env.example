NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- REQUIRED ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/radio_rainy
REDIS_URL=redis://localhost:6379

# Encrypts EVERY secret stored in the database (Telegram session + API hash, Whisper/LLM keys) with AES-256-GCM.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (keep it safe: without it stored secrets cannot be decrypted)
TELEGRAM_SESSION_ENCRYPTION_KEY=

ADMIN_EMAIL=
# generate: pnpm --silent --filter @radio_rainy/api hash-password 'your-password'   (format scrypt:<salt>:<hash>)
ADMIN_PASSWORD_HASH=
# at least 32 chars
JWT_SECRET=

# ---- OPTIONAL: everything below is normally configured from the admin panel (Settings / Channels pages) ----
# Telegram API id/hash (my.telegram.org): panel -> Settings. These env vars are only a fallback.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional bootstrap of an existing session string (imported once, stored encrypted). Normally: log in from the panel.
TELEGRAM_SESSION=

# Whisper-compatible endpoint (OpenAI /v1/audio/transcriptions). Panel -> Settings -> Whisper. Empty = AI lyrics sync off.
WHISPER_URL=
WHISPER_MODEL=whisper-1
WHISPER_API_KEY=
WHISPER_LANGUAGE=
# audio sent to Whisper is converted to this sample rate (mono FLAC)
WHISPER_SAMPLE_RATE=48000

RADIO_RECENT_TRACK_WINDOW=10
RADIO_PREBUFFER_SECONDS=2
RADIO_STREAM_BITRATE_KBPS=128
LYRICS_CACHE_TTL=86400
TELEGRAM_SYNC_INTERVAL_SECONDS=300
FFMPEG_PATH=ffmpeg
TMP_DIR=/tmp/radio_rainy
QUEUE_PREFIX=radio_rainy
