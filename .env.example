NODE_ENV=development
PORT=3000

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: leave empty and log in from the Super Admin panel (session is stored encrypted in the DB)
TELEGRAM_SESSION=
# openssl rand -hex 32
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_CHANNEL=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/radio_rainy
REDIS_URL=redis://localhost:6379

RADIO_RECENT_TRACK_WINDOW=10
RADIO_PREBUFFER_SECONDS=2

# Whisper-compatible (OpenAI style /v1/audio/transcriptions) endpoint
# All WHISPER_* are optional: leave WHISPER_URL empty to disable AI lyrics sync completely
WHISPER_PROVIDER=openai-compatible
WHISPER_MODEL=whisper-1
WHISPER_URL=
WHISPER_API_KEY=

LYRICS_CACHE_TTL=86400

ADMIN_EMAIL=
# generate: pnpm --silent --filter @radio_rainy/api hash-password 'your-password'   (format scrypt:<salt>:<hash>)
ADMIN_PASSWORD_HASH=
JWT_SECRET=
